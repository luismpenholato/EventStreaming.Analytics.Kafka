# EventStreaming.Analytics.Kafka — sample requests
# Requires Docker Compose: docker compose up --build
# Extension: REST Client (VS Code / Rider)
#
# Optional header: X-Correlation-Id (propagated to logs and Kafka headers)

@trackingBase = http://localhost:5001
@queryBase = http://localhost:5002
@correlationId = 11111111-1111-1111-1111-111111111111

### Health — Tracking API
GET {{trackingBase}}/health

### Health — Query API
GET {{queryBase}}/health

###############################################################################
# Tracking API — 202 = event stored in Outbox (Kafka publish is async)
###############################################################################

### Product Viewed
POST {{trackingBase}}/api/events/product-viewed
Content-Type: application/json
X-Correlation-Id: {{correlationId}}

{
  "userId": "user-1",
  "productId": "prod-42",
  "sessionId": "session-abc"
}

### Product Added To Cart
POST {{trackingBase}}/api/events/product-added-to-cart
Content-Type: application/json
X-Correlation-Id: {{correlationId}}

{
  "userId": "user-1",
  "productId": "prod-42",
  "quantity": 2
}

### Checkout Started
POST {{trackingBase}}/api/events/checkout-started
Content-Type: application/json
X-Correlation-Id: {{correlationId}}

{
  "userId": "user-1",
  "cartId": "cart-99",
  "totalAmount": 199.90
}

### Order Completed
POST {{trackingBase}}/api/events/order-completed
Content-Type: application/json
X-Correlation-Id: {{correlationId}}

{
  "userId": "user-1",
  "orderId": "order-5001",
  "totalAmount": 199.90,
  "productIds": ["prod-42", "prod-7"]
}

### User Logged In
POST {{trackingBase}}/api/events/user-logged-in
Content-Type: application/json
X-Correlation-Id: {{correlationId}}

{
  "userId": "user-1",
  "ipAddress": "192.168.0.10",
  "userAgent": "PortfolioDemo/1.0"
}

###############################################################################
# Query API — wait a few seconds after the POST requests above
###############################################################################

### Product analytics
GET {{queryBase}}/api/analytics/products/prod-42
X-Correlation-Id: {{correlationId}}

### Summary
GET {{queryBase}}/api/analytics/summary
X-Correlation-Id: {{correlationId}}

### Events by type
GET {{queryBase}}/api/analytics/events-by-type
X-Correlation-Id: {{correlationId}}

### Conversion rate
GET {{queryBase}}/api/analytics/conversion-rate
X-Correlation-Id: {{correlationId}}
